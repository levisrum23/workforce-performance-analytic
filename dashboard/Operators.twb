      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0rolywo1vcnm3q1f10jju09t4wey].[avg:Calculation_4922025039052802:qk]&quot;' value='Avg Gap' />
          <alias key='&quot;[federated.0rolywo1vcnm3q1f10jju09t4wey].[avg:DLP Score:qk]&quot;' value='Avg DLP' />
          <alias key='&quot;[federated.0rolywo1vcnm3q1f10jju09t4wey].[avg:PQS Score:qk]&quot;' value='Avg PQS' />
          <alias key='&quot;[federated.0rolywo1vcnm3q1f10jju09t4wey].[ctd:Operator ID:qk]&quot;' value='Operators' />
        </aliases>
      </column>
      <column caption='Quadrant' datatype='string' name='[Calculation_4922025038626817]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DLP Score] &gt;= [Parameters].[Parameter 1] AND [PQS Score] &gt;= [Parameters].[p_DLP_threshold (copy)_4922025038221312]&#10;    THEN &quot;Q1 - High Achiever&quot;&#10;ELSEIF [DLP Score] &lt; [Parameters].[Parameter 1] AND [PQS Score] &gt;= [Parameters].[p_DLP_threshold (copy)_4922025038221312]&#10;    THEN &quot;Q2 - Test Review&quot;&#10;ELSEIF [DLP Score] &gt;= [Parameters].[Parameter 1] AND [PQS Score] &lt; [Parameters].[p_DLP_threshold (copy)_4922025038221312]&#10;    THEN &quot;Q3 - Training Transfer&quot;&#10;ELSE &quot;Q4 - Retrain&quot;&#10;END' />
        <aliases>
          <alias key='&quot;Q1 - High Achiever&quot;' value='Q1 High Achiever' />
          <alias key='&quot;Q2 - Test Review&quot;' value='Q2 Test Review' />
          <alias key='&quot;Q3 - Training Transfer&quot;' value='Q3 Training Transfer' />
          <alias key='&quot;Q4 - Retrain&quot;' value='Q4 Retrain' />
        </aliases>
      </column>
      <column caption='Performance Gap' datatype='integer' name='[Calculation_4922025039052802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[PQS Score]-[DLP Score]' />
      </column>
      <column caption='Tenure Group' datatype='string' name='[Calculation_4922025039384579]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tenure (Years)] &lt;= 3 THEN &quot;Junior (0-3) yr&quot;&#10;ELSEIF [Tenure (Years)] &lt;= 8 THEN &quot;Mid (4-8) yr&quot;&#10;ELSE &quot;Senior (9+) yr&quot;&#10;END' />
      </column>
      <column caption='Is Q1' datatype='integer' name='[Calculation_4922025039728644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4922025038626817] = &quot;Q1 - High Achiever&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Is Q3' datatype='integer' name='[Calculation_4922025039872005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4922025038626817] = &quot;Q3 - Training Transfer&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Is Q4' datatype='integer' name='[Calculation_4922025040179206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4922025038626817] = &quot;Q4 - Retrain&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Operator Label' datatype='string' name='[Calculation_4922025040347143]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Operator Name] + &quot; • &quot; + [Department] + &quot; • &quot; + STR([Tenure (Years)]) + &quot; yr&quot;' />
      </column>
      <column caption='Q3 Pct' datatype='real' name='[Calculation_4922025115217928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4922025039872005])/COUNTD([Operator ID])' />
      </column>
      <column caption='Q1 Pct' datatype='real' name='[Calculation_4922025115439113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4922025039728644])/COUNTD([Operator ID])' />
      </column>
      <column caption='Q4 Pct' datatype='real' name='[Calculation_4922025115549706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4922025040179206])/COUNTD([Operator ID])' />
      </column>
      <column caption='Dept Gap Label' datatype='string' name='[Calculation_4922025183825931]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF(AVG([PQS Score]) - AVG([DLP Score]) &gt;= 0,&#10;       &quot;+&quot; + STR(ROUND(AVG([PQS Score]) - AVG([DLP Score]), 1)),&#10;       STR(ROUND(AVG([PQS Score]) - AVG([DLP Score]), 1)))' />
      </column>
      <column caption='Dept Gap' datatype='real' name='[Calculation_4922025191841804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([PQS Score]) - AVG([DLP Score])' />
      </column>
      <column caption='Gap Label Negative' datatype='string' name='[Calculation_4922025195704333]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([PQS Score]) - AVG([DLP Score]) &lt; 0&#10;THEN STR(ROUND(AVG([PQS Score]) - AVG([DLP Score]), 1))&#10;END' />
      </column>
      <column caption='Label Anchor' datatype='integer' name='[Calculation_4922025202003983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column datatype='integer' name='[DLP Score]' role='measure' type='quantitative' />
      <column datatype='string' name='[Department]' role='dimension' type='nominal' />
      <column caption='Gap Label Positive' datatype='string' name='[Gap Label Negative (copy)_4922025195765774]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([PQS Score]) - AVG([DLP Score]) &gt;= 0&#10;THEN &quot;+&quot; + STR(ROUND(AVG([PQS Score]) - AVG([DLP Score]), 1))&#10;END' />
      </column>
